# ===================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - REDTEC API REST
# Copiar este archivo a .env y ajustar valores según el entorno local.
# ===================================================================

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Base de Datos MySQL / MariaDB (Requeridas para arranque)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=redtec_db
DB_USER=root
DB_PASSWORD=root

# Seguridad y Autenticación JWT (Requerida para arranque)
JWT_SECRET=clave_secreta_jwt_para_firmar_tokens_redtec_2026
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Reglas de Negocio
MAX_DIAS_PRESTAMO=30

# CORS (Orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Credenciales del Administrador para el Seeder Inicial
ADMIN_EMAIL=admin@redtec.org
ADMIN_PASSWORD=Admin123!
