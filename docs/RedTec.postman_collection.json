            },
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"]
            }
          }
        },
        {
          "name": "2.4 Actualizar Equipo (Solo Admin)",
