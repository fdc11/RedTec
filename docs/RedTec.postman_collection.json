{
  "info": {
    "_postman_id": "b3e94582-7f12-4c23-95ad-e83fa9871142",
    "name": "RedTec API REST - Colección Oficial",
    "description": "Colección completa de pruebas para la API REST de RedTec (Node.js, Express, Sequelize, MySQL). Incluye todos los casos de éxito y los escenarios de error esperados (criterios de aceptación 1 al 7, token inválido y validación fallida).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenCarlos",
      "value": "",
      "type": "string"
    },
