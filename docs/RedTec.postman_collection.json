    {
      "name": "2. Equipos (Inventario)",
      "item": [
        {
          "name": "2.1 Listar Equipos Disponibles (Filtro ?estado=Disponible)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCarlos}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos?estado=Disponible",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"],
              "query": [
                {
                  "key": "estado",
                  "value": "Disponible"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 Obtener Equipo por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCarlos}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos", "1"]
            }
          }
        },
        {
          "name": "2.3 Crear Nuevo Equipo (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [
