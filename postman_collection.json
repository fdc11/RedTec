{
  "info": {
    "_postman_id": "redtec-api-collection-v1",
    "name": "RedTec - API REST Segura (Colección Oficial de Pruebas)",
    "description": "Colección completa de pruebas para la API REST de RedTec. Incluye todos los endpoints de autenticación, CRUD de equipos, flujo de préstamos/devoluciones y la verificación estricta de las 3 reglas de negocio y seguridad RBAC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenUsuario",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenMoroso",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Autenticación y Control de Acceso",
      "item": [
        {
          "name": "1.1 Login Administrador (Guarda tokenAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenAdmin', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@redtec.org\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login Usuario Regular - Carlos (Guarda tokenUsuario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenUsuario', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@redtec.org\",\n  \"password\": \"Usuario123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login Usuario Moroso - Lucia (Guarda tokenMoroso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenMoroso', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lucia@redtec.org\",\n  \"password\": \"Usuario123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Registro de Usuario Nuevo (Forzado rol usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria Fernandez\",\n  \"email\": \"maria.test@redtec.org\",\n  \"password\": \"Segura123!\",\n  \"rol\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "description": "Demuestra la regla de seguridad: Aunque en el body se envíe rol 'admin', la API asigna forzosamente 'usuario'."
          }
        },
        {
          "name": "1.5 Consultar Perfil Autenticado y Métricas de Mora",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "perfil"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Inventario de Equipos (CRUD y RBAC)",
      "item": [
        {
          "name": "2.1 Listar Todos los Equipos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"]
            }
          }
        },
        {
          "name": "2.2 Filtrar Equipos Disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/equipos?estado=Disponible",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"],
              "query": [
                {
                  "key": "estado",
                  "value": "Disponible"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Obtener Detalle de Equipo por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/equipos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos", "1"]
            }
          }
        },
        {
          "name": "2.4 Crear Equipo como Admin (Éxito -> 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cámara Canon EOS 90D 4K\",\n  \"categoria\": \"Audiovisual\",\n  \"estado\": \"Disponible\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"]
            }
          }
        },
        {
          "name": "2.5 RBAC: Intento de Crear Equipo por Usuario Común (Fallo -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Equipo No Autorizado\",\n  \"categoria\": \"Herramientas\",\n  \"estado\": \"Disponible\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos"]
            }
          }
        },
        {
          "name": "2.6 Actualizar Equipo como Admin (Éxito -> 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laptop Dell XPS 13 Plus (Actualizada)\",\n  \"categoria\": \"Laptops\",\n  \"estado\": \"Disponible\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos", "1"]
            }
          }
        },
        {
          "name": "2.7 RBAC: Intento de Eliminar Equipo por Usuario Común (Fallo -> 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Préstamos y Verificación de las 3 Reglas de Negocio",
      "item": [
        {
          "name": "3.1 Solicitar Préstamo Válido (Éxito -> 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 3,\n  \"fechaDevolucionEsperada\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            }
          }
        },
        {
          "name": "3.2 REGLA 1: Fallo por Límite de 2 Equipos (Fallo -> 400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 5,\n  \"fechaDevolucionEsperada\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            },
            "description": "Carlos ya tiene 2 préstamos activos (uno del seed y el solicitado en 3.1). Al pedir un 3.er equipo, el middleware de límite lo rechaza con 400."
          }
        },
        {
          "name": "3.3 REGLA 2: Sanción Automática por Mora (Fallo -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403 Forbidden por sanción de mora', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMoroso}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 7,\n  \"fechaDevolucionEsperada\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            },
            "description": "Lucia tiene un préstamo vencido no devuelto en los seeds. El middleware mora.middleware.js detecta la mora calculada en tiempo real y deniega la solicitud con HTTP 403 Forbidden."
          }
        },
        {
          "name": "3.4 REGLA 3: Equipo No Disponible o en Mantenimiento (Fallo -> 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 409 Conflict por no estar Disponible', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 6,\n  \"fechaDevolucionEsperada\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            },
            "description": "El equipo 6 (Taladro Bosch) tiene estado 'En mantenimiento'. La transacción con bloqueo de fila LOCK.UPDATE detecta que no está 'Disponible' y rechaza la solicitud."
          }
        },
        {
          "name": "3.5 Registrar Devolución de Préstamo (Éxito -> 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/3/devolver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos", "3", "devolver"]
            },
            "description": "Carlos devuelve el préstamo 3. El préstamo marca fechaDevolucionReal y el equipo vuelve a estar 'Disponible'."
          }
        },
        {
          "name": "3.6 Listar Mis Préstamos (Usuario Autenticado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/mis-prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos", "mis-prestamos"]
            }
          }
        },
        {
          "name": "3.7 Listar Todos los Préstamos del Sistema (Solo Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            }
          }
        }
      ]
    }
  ]
}
